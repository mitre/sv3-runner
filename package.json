{
  "name": "sv3-runner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Extract and run STIG Viewer 3 on any platform for CKLB acceptance testing",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "download": "node scripts/setup.mjs --download",
    "status": "node scripts/setup.mjs --status",
    "clean": "node scripts/setup.mjs --clean",
    "start": "node scripts/run.mjs",
    "test": "npx playwright test"
  },
  "dependencies": {
    "electron": "40.1.0",
    "sqlite3": "^5.1.7",
    "@electron/asar": "^4.2.0",
    "@electron/rebuild": "^3.7.1"
  }
}
