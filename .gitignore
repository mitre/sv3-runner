# Dependencies
node_modules/

# Extracted SV3 app (generated by setup)
sv3-app/

# SV3 zip files (user-provided, large binaries) + their DISA hash manifests
downloads/*.zip
downloads/*_Hashes.txt

# Electron cache
.electron/

# Build artifacts
*.node

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Logs
*.log

# Test results
test-results/
playwright-report/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Local session-recovery files (per-machine, not shared)
.beads/recovery-context.md
.beads/recovery-prompt.md
.beads/archive/

# Agent interaction log — chatty per-session work-tracking metadata,
# not shared in the public repo (issues sync via Dolt refs, not this file)
.beads/interactions.jsonl
